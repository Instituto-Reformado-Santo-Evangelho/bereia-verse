# Bereia Verse - Configuração de Ambiente Local
# Copie este arquivo para .env e preencha com suas credenciais

# === GitHub Personal Access Token ===
# Usado para sincronização de dados via GitHub
GH_PAT_BEREIA=your_github_pat_here

# === Google Drive API Credentials ===
# Conteúdo do arquivo client_secrets.json (formato JSON em uma linha)
# Exemplo: {"installed":{"client_id":"...","project_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_secret":"...","redirect_uris":["..."]}}
GOOGLE_CLIENT_SECRETS={"installed":{"client_id":"your_client_id","project_id":"your_project","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_secret":"your_client_secret","redirect_uris":["http://localhost"]}}

# === MSIX Certificate (Windows) ===
# Certificado PFX em Base64 (usado no CI/CD ou build automatizado)
MSIX_PFX_BASE64=your_certificate_base64_here

# Senha do certificado PFX
MSIX_PFX_PASSWORD=irse2026

# === Caminhos Locais (Opcionais) ===
# Se preferir usar arquivos locais ao invés de Base64
MSIX_PFX_PATH=installers/windows/BereiaVerse_SelfSigned.pfx
GOOGLE_CLIENT_SECRETS_PATH=client_secrets.json
