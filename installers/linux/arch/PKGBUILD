# Maintainer: Heleno <seu-email@exemplo.com>
pkgname=bereia-verse-bin
pkgver=1.0.0
pkgrel=1
pkgdesc="Leitor de versículos bíblicos (ACF) com detecção automática de clipboard."
arch=('x86_64')
url="https://github.com/heleno/verse-extension"
license=('MIT')
depends=('java-runtime>=17' 'gtk3')
makedepends=('jdk17-openjdk' 'gradle')
provides=('bereia-verse')
conflicts=('bereia-verse' 'verse-reader')
options=('!strip')

find_project_root() {
    local dir="$1"
    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/gradlew" ]]; then
            echo "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

build() {
    local project_root=$(find_project_root "$startdir")
    if [[ -z "$project_root" ]]; then return 1; fi
    cd "$project_root"
    chmod +x gradlew
    ./gradlew :composeApp:createDistributable --no-daemon
}

package() {
    local project_root=$(find_project_root "$startdir")
    local build_dir="$project_root/composeApp/build/compose/binaries/main/app/bereia-verse"
    local dest_dir="${pkgdir}/opt/bereia-verse"

    mkdir -p "${dest_dir}"
    cp -r "${build_dir}"/* "${dest_dir}/"
    chmod +x "${dest_dir}/bin/bereia-verse"

    mkdir -p "${pkgdir}/usr/bin"
    ln -sf "/opt/bereia-verse/bin/bereia-verse" "${pkgdir}/usr/bin/bereia-verse"

    mkdir -p "${pkgdir}/usr/share/pixmaps"
    cp "$project_root/composeApp/src/commonMain/composeResources/drawable/logo.png" "${pkgdir}/usr/share/pixmaps/bereia-verse.png"

    mkdir -p "${pkgdir}/usr/share/applications"
    cat > "${pkgdir}/usr/share/applications/bereia-verse.desktop" <<EOF
[Desktop Entry]
Name=Bereia Verse
Comment=Leitor Bíblico Automático
Exec=bereia-verse
Icon=bereia-verse
Terminal=false
Type=Application
Categories=Utility;Education;
EOF
}
